<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.chart.*?>
<?import javafx.geometry.Insets?>

<HBox xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.usta.ecogrow.controllers.LoginController" styleClass="auth-root">
    <StackPane fx:id="hero" styleClass="hero" HBox.hgrow="ALWAYS" prefWidth="620" minWidth="420">
        <Pane mouseTransparent="true">
            <Circle centerX="560" centerY="60" radius="240" styleClass="hero-circle"/>
            <Circle centerX="40" centerY="760" radius="300" styleClass="hero-circle"/>
            <Circle centerX="420" centerY="520" radius="110" styleClass="hero-circle-strong"/>
        </Pane>
        <VBox alignment="CENTER_LEFT" spacing="26" maxWidth="460" StackPane.alignment="CENTER_LEFT">
            <padding><Insets left="64" right="40"/></padding>
            <HBox alignment="CENTER_LEFT" spacing="12">
                <Label text="EcoGrow" userData="icon:leaf:34" styleClass="hero-brand"/>
            </HBox>
            <Label styleClass="hero-title" wrapText="true" text="Tecnología al servicio de la conservación y la reforestación."/>
            <VBox spacing="14">
                <Label styleClass="hero-point" userData="icon:ok:20" wrapText="true" text="Gestiona áreas de vida y su estado de conservación."/>
                <Label styleClass="hero-point" userData="icon:ok:20" wrapText="true" text="Da seguimiento a siembras y censos forestales."/>
                <Label styleClass="hero-point" userData="icon:ok:20" wrapText="true" text="Centraliza la documentación ambiental en un solo lugar."/>
            </VBox>
        </VBox>
    </StackPane>

    <StackPane styleClass="auth-panel" prefWidth="560" minWidth="440">
        <VBox spacing="18" maxWidth="380" alignment="CENTER_LEFT" StackPane.alignment="CENTER">
            <VBox spacing="4">
                <Label styleClass="auth-title" text="Bienvenido de nuevo"/>
                <Label styleClass="auth-subtitle" text="Ingresa con tu cuenta para continuar."/>
            </VBox>

            <Label fx:id="messageLabel" styleClass="msg" wrapText="true" visible="false" managed="false"/>
            <Hyperlink fx:id="retryLink" text="Reintentar conexión" onAction="#onRetry" visible="false" managed="false"/>

            <VBox spacing="6">
                <Label styleClass="field-label" text="Correo electrónico"/>
                <TextField fx:id="emailField" promptText="correo@ejemplo.com" onAction="#onLogin"/>
            </VBox>
            <VBox spacing="6">
                <Label styleClass="field-label" text="Contraseña"/>
                <PasswordField fx:id="passwordField" promptText="Tu contraseña" onAction="#onLogin"/>
            </VBox>

            <Button fx:id="loginButton" text="Iniciar sesión" onAction="#onLogin" styleClass="btn-primary,btn-large" maxWidth="Infinity" defaultButton="true"/>

            <HBox alignment="CENTER" spacing="4">
                <Label styleClass="auth-subtitle" text="¿No tienes cuenta?"/>
                <Hyperlink text="Regístrate" onAction="#onSignUp"/>
            </HBox>
        </VBox>
    </StackPane>
</HBox>
